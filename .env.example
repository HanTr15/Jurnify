DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SECRET_KEY=generate-a-long-random-secret
ADMIN_PASSWORD=use-a-strong-initial-admin-password
# Vercel injects BLOB_STORE_ID and OIDC credentials when the private store is connected.
# For manual token auth, use BLOB_READ_WRITE_TOKEN from Vercel Storage.
